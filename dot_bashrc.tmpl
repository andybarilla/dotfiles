# =============================================================================
# Bash Configuration
# =============================================================================

# Skip the rest for non-interactive shells.
case $- in *i*) ;; *) return ;; esac

# --- Shared env (mirrors zshenv) ---
[ -f ~/.bash_env ] && . ~/.bash_env

# --- History ---
HISTFILE=~/.bash_history
HISTSIZE=10000
HISTFILESIZE=10000
HISTCONTROL=ignoredups:erasedups
HISTTIMEFORMAT='%F %T '
shopt -s histappend
# Append each command to HISTFILE immediately and reload so new shells see it.
PROMPT_COMMAND='history -a; history -n'"${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

# --- Shell options ---
shopt -s checkwinsize
shopt -s globstar 2>/dev/null

# --- Completion ---
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

# --- Environment ---
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
export HAPPY_SERVER_URL="https://happy.andybarilla.com"
if command -v podman &>/dev/null; then
    export DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
fi
export GLM_CODING_PLAN_KEY={{ onepasswordRead "op://Personal/Z.AI GLM Coding Plan Key/password" "me@andybarilla.com" | quote }}

# --- PATH ---
# Prepend $1 to PATH if the directory exists and isn't already present.
_path_prepend() {
    [ -d "$1" ] || return
    case ":$PATH:" in *":$1:"*) return ;; esac
    PATH="$1:$PATH"
}
_path_prepend "$HOME/SynologyDrive/scripts"
_path_prepend "$HOME/go/bin"
_path_prepend "$HOME/.opencode/bin"
_path_prepend "$HOME/.cargo/bin"
_path_prepend "$HOME/.config/herd-lite/bin"
_path_prepend "$HOME/Applications/depot_tools"
_path_prepend "$HOME/bin"
_path_prepend "$HOME/.local/bin"

# --- Tool activation ---
if command -v nvim &>/dev/null; then
    alias vi='nvim'
fi

if command -v batcat &>/dev/null; then
    alias bat='batcat'
fi

if command -v tea-cli &>/dev/null; then
    alias tea='tea-cli'
    source <(tea-cli completion bash)
fi

if command -v mise &>/dev/null; then
    eval "$(mise activate bash)"
fi

if command -v fzf &>/dev/null; then
    eval "$(fzf --bash)"
fi

# --- Source modular configs ---
for f in ~/.bashrc.d/*.bash; do . "$f"; done

export PATH="$HOME/.config/herd-lite/bin:$PATH"
export PHP_INI_SCAN_DIR="$HOME/.config/herd-lite/bin:$PHP_INI_SCAN_DIR"

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init bash)"; fi

export PATH="$HOME/.npm-global/bin:$PATH"

export GPG_TTY=$(tty)

if [ -d "/home/linuxbrew" ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# pnpm
export PNPM_HOME="/home/andy/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

eval "$(~/.local/bin/mise activate bash)"

# --- Prompt (Starship) ---
# Must be last so $PATH is finalized before `command -v starship` runs.
if command -v starship &>/dev/null; then
    eval "$(starship init bash)"
fi
