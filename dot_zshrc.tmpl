# =============================================================================
# ZSH Configuration
# =============================================================================

# --- History ---
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS

# --- Completion ---
autoload -Uz compinit
compinit
setopt COMPLETE_IN_WORD
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# --- Prompt (Pure) ---
# Install: mkdir -p "$HOME/.zsh/pure" && git clone https://github.com/sindresorhus/pure.git "$HOME/.zsh/pure"
if [[ -d "$HOME/.zsh/pure" ]]; then
    fpath+=("$HOME/.zsh/pure")
    autoload -U promptinit; promptinit
    prompt pure

    # Use a visible color for the prompt symbol (default magenta is too dark in our theme)
    zstyle ':prompt:pure:prompt:success' color cyan

    # Always show hostname in Pure prompt
    prompt_pure_always_show_host() {
        psvar[13]=1
        prompt_pure_state[user_color]=${prompt_pure_state[user_color]:-user}
    }
    add-zsh-hook precmd prompt_pure_always_show_host
else
    autoload -Uz promptinit; promptinit
    prompt walters 2>/dev/null || prompt clint 2>/dev/null || PS1="%n@%m %~ %# "
fi

# --- Environment ---
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
export HAPPY_SERVER_URL="https://happy.andybarilla.com"
export DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
export ANTHROPIC_API_KEY={{ onepasswordRead "op://dev/Anthropic API/credential" "andy@titlevision.ai" | quote }}
export GITHUB_PERSONAL_ACCESS_TOKEN={{ onepasswordRead "op://Personal/GitHub PAT/password" "me@andybarilla.com" | quote }}
export GLM_CODING_PLAN_KEY={{ onepasswordRead "op://Personal/Z.AI GLM Coding Plan Key/password" "me@andybarilla.com" | quote }}

# --- PATH ---
typeset -U path
[[ -d ~/.local/bin ]] && path=(~/.local/bin $path)
[[ -d ~/bin ]] && path=(~/bin $path)
[[ -d ~/Applications/depot_tools ]] && path=(~/Applications/depot_tools $path)
[[ -d ~/.config/herd-lite/bin ]] && path=(~/.config/herd-lite/bin $path)
[[ -d ~/.cargo/bin ]] && path=(~/.cargo/bin $path)
[[ -d ~/.opencode/bin ]] && path=(~/.opencode/bin $path)
[[ -d ~/go/bin ]] && path=(~/go/bin $path)
[[ -d ~/SynologyDrive/scripts ]] && path=(~/SynologyDrive/scripts $path)

# --- Tool activation ---
if command -v nvim &>/dev/null; then
    alias vi='nvim'
fi

if command -v batcat &>/dev/null; then
    alias bat='batcat'
fi

if command -v fdfind &>/dev/null; then
    alias fd='fdfind'
fi

if command -v mise &>/dev/null; then
    eval "$(mise activate zsh)"
fi

# --- Distrobox / Container ---
if [[ -n "$CONTAINER_ID" ]]; then
    PROMPT="[${CONTAINER_ID}] $PROMPT"
    export SSH_AUTH_SOCK=/run/host/home/andy/.1password/agent.sock
    [[ -f /home/andy/.zshrc.d/containers/${CONTAINER_ID}.zsh ]] && source /home/andy/.zshrc.d/containers/${CONTAINER_ID}.zsh
fi

# --- Source modular configs ---
for f in /home/andy/.zshrc.d/*.zsh(N); do source "$f"; done
export PATH="/home/andy/.config/herd-lite/bin:$PATH"
export PHP_INI_SCAN_DIR="/home/andy/.config/herd-lite/bin:$PHP_INI_SCAN_DIR"

# export OPENAI_BASE_URL=http://apbmini:11434/v1 
# export OPENAI_API_KEY=ollama
# export OPENAI_API_MODEL=deepseek-r1:8b


if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

export PATH="$HOME/.npm-global/bin:$PATH"

export GPG_TTY=$(tty)
