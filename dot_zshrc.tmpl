# =============================================================================
# ZSH Configuration
# =============================================================================

# --- History ---
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS

# --- Completion ---
autoload -Uz compinit
compinit
setopt COMPLETE_IN_WORD
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# --- Environment ---
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
export HAPPY_SERVER_URL="https://happy.andybarilla.com"
if command -v podman &>/dev/null; then
    export DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
fi
export GLM_CODING_PLAN_KEY={{ onepasswordRead "op://Personal/Z.AI GLM Coding Plan Key/password" "me@andybarilla.com" | quote }}

# --- PATH ---
typeset -U path
[[ -d ~/.local/bin ]] && path=(~/.local/bin $path)
[[ -d ~/bin ]] && path=(~/bin $path)
[[ -d ~/Applications/depot_tools ]] && path=(~/Applications/depot_tools $path)
[[ -d ~/.config/herd-lite/bin ]] && path=(~/.config/herd-lite/bin $path)
[[ -d ~/.cargo/bin ]] && path=(~/.cargo/bin $path)
[[ -d ~/.opencode/bin ]] && path=(~/.opencode/bin $path)
[[ -d ~/go/bin ]] && path=(~/go/bin $path)
[[ -d ~/SynologyDrive/scripts ]] && path=(~/SynologyDrive/scripts $path)

# --- Tool activation ---
if command -v nvim &>/dev/null; then
    alias vi='nvim'
fi

if command -v batcat &>/dev/null; then
    alias bat='batcat'
fi

if command -v tea-cli &>/dev/null; then
    alias tea='tea-cli'
    source <(tea-cli completion zsh)
fi

if command -v fdfind &>/dev/null; then
    alias fd='fdfind'
fi

if command -v mise &>/dev/null; then
    eval "$(mise activate zsh)"
fi

# --- Source modular configs ---
for f in ~/.zshrc.d/*.zsh(N); do source "$f"; done
export PATH="$HOME/.config/herd-lite/bin:$PATH"
export PHP_INI_SCAN_DIR="$HOME/.config/herd-lite/bin:$PHP_INI_SCAN_DIR"

# export OPENAI_BASE_URL=http://apbmini:11434/v1 
# export OPENAI_API_KEY=ollama
# export OPENAI_API_MODEL=deepseek-r1:8b


if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

export PATH="$HOME/.npm-global/bin:$PATH"

export GPG_TTY=$(tty)

if [[ -d "/home/linuxbrew" ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# --- Prompt (Starship) ---
# Must be last so $PATH is finalized before `command -v starship` runs.
if command -v starship &>/dev/null; then
    eval "$(starship init zsh)"
else
    autoload -Uz promptinit; promptinit
    prompt walters 2>/dev/null || prompt clint 2>/dev/null || PS1="%n@%m %~ %# "
fi
