layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="status-bar"
        }
    }
    tab name="claude-1" {
        pane command="zsh" {
            args "-ic" "claude"
        }
    }
    tab name="claude-2" {
        pane command="zsh" {
            args "-ic" "claude"
        }
    }
    tab name="claude-3" {
        pane command="zsh" {
            args "-ic" "claude"
        }
    }
    tab name="claude-4" {
        pane command="zsh" {
            args "-ic" "claude"
        }
    }
}
