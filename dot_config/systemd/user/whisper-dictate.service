[Unit]
Description=Push-to-talk dictation daemon (OpenAI Whisper)
After=pipewire.service

[Service]
Type=simple
ExecStart=%h/.local/bin/whisper-dictate
EnvironmentFile=-%h/.config/whisper-dictate/config
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
