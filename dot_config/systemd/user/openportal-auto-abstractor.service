[Unit]
Description=OpenPortal - auto-abstractor
After=network.target

[Service]
Environment=PATH=/home/andy/.opencode/bin:/home/andy/.local/bin:/home/andy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/sbin/bunx openportal --name auto-abstractor --port 4301
WorkingDirectory=/home/andy/dev/titlevision-ai/auto-abstractor
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
