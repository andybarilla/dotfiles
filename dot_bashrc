# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc
export PATH="/home/andy/.config/herd-lite/bin:$PATH"
export PHP_INI_SCAN_DIR="/home/andy/.config/herd-lite/bin:$PHP_INI_SCAN_DIR"

ghcloneall() {
	gh repo list $1 --limit 4000 | while read -r repo _; do
		gh repo clone "$repo" "$repo"
	done
}

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/var/home/andy/google-cloud-sdk/path.bash.inc' ]; then . '/var/home/andy/google-cloud-sdk/path.bash.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/var/home/andy/google-cloud-sdk/completion.bash.inc' ]; then . '/var/home/andy/google-cloud-sdk/completion.bash.inc'; fi
export PATH="$HOME/.local/bin:$PATH"
